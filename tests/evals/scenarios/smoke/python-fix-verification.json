{
  "id": "python-fix-verification",
  "description": "The agent fixes a failing Python test and the verification gate proves it.",
  "fixture": "python-calculator",
  "prompt": "Fix the failing test in calculator.py. Use the tools, then report the result.",
  "verify": true,
  "sandbox": "workspace",
  "permission": "auto",
  "script": [
    {
      "text": "Reading the calculator.",
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "calculator.py"
          }
        }
      ]
    },
    {
      "text": "Fixing the subtraction.",
      "tool_calls": [
        {
          "name": "edit_file",
          "arguments": {
            "path": "calculator.py",
            "old_string": "    return a - b",
            "new_string": "    return a + b"
          }
        }
      ]
    },
    {
      "text": "Fixed the add function; the test suite now passes.",
      "usage": {
        "input_tokens": 2400,
        "output_tokens": 180
      }
    }
  ],
  "assertions": {
    "exit_code": 0,
    "files": {
      "calculator.py": "return a + b"
    },
    "events_include": [
      "turn/start",
      "tool/call",
      "tool/result",
      "verification",
      "turn/end"
    ],
    "verification_passed": true,
    "max_tool_calls": 3
  }
}
